#: ../../advanced_email_management/toc.rst:610
msgid "# When you receive a signed email, the signature is displayed in the email header. # Click on the signature to view the certificate details. # The certificate details include the certificate issuer, the certificate validity period, and the certificate fingerprint. # The recipient can verify the signature using the sender’s public key."
msgstr "# При получении подписанного электронного письма подпись отображается в заголовке письма. # Щелкните подпись, чтобы просмотреть сведения о сертификате. # Сведения о сертификате включают в себя издателя сертификата, период действия сертификата и отпечаток сертификата. # Получатель может проверить подпись с помощью открытого ключа отправителя."

#: ../../advanced_email_management/toc.rst:615
msgid "Если подпись действительна:"
msgstr ""

#: ../../advanced_email_management/toc.rst:617
